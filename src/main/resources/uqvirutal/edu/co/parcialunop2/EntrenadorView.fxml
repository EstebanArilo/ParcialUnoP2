<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uqvirutal.edu.co.parcialunop2.controller.EntrenadorController">
    <!-- Encabezado con Botón de Regreso -->
    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1b4332; -fx-padding: 10;">
        <Button onAction="#handleVolverMenu" style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-font-weight: bold;" text="← Menú Principal" />
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Gestión de Entrenadores - SmartGym" />
    </HBox>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Formulario de Entrada -->
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Identificación (ID):" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtId" promptText="Número de identificación / Cédula" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtNombre" promptText="Nombre completo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtTelefono" promptText="Número telefónico" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Especialidad:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtEspecialidad" promptText="Ej: Musculación, Funcional, Yoga..." GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>

    <!-- Botones CRUD -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#handleRegistrarEntrenador" style="-fx-background-color: #2ec4b6; -fx-text-fill: white;" text="Registrar" />
        <Button onAction="#handleActualizarEntrenador" text="Actualizar" />
        <Button onAction="#handleEliminarEntrenador" style="-fx-background-color: #e63946; -fx-text-fill: white;" text="Eliminar" />
        <Button onAction="#handleLimpiarCampos" text="Limpiar" />
    </HBox>

    <!-- Tabla de Entrenadores -->
    <TableView fx:id="tblEntrenadores" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="120.0" text="ID / Cédula" />
            <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
            <TableColumn fx:id="colTelefono" prefWidth="130.0" text="Teléfono" />
            <TableColumn fx:id="colEspecialidad" prefWidth="180.0" text="Especialidad" />
        </columns>
    </TableView>
</VBox>