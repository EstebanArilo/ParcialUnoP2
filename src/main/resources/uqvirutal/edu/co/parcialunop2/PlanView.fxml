<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uqvirutal.edu.co.parcialunop2.controller.PlanController">
    <!-- Encabezado con Botón de Regreso -->
    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1b4332; -fx-padding: 10;">
        <Button onAction="#handleVolverMenu" style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-font-weight: bold;" text="← Menú Principal" />
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Gestión de Planes de Entrenamiento - SmartGym" />
    </HBox>

    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
    </padding>

    <!-- Formulario de Entrada -->
    <GridPane hgap="10.0" vgap="8.0">
        <columnConstraints>
            <ColumnConstraints minWidth="130.0" />
            <ColumnConstraints hgrow="ALWAYS" />
            <ColumnConstraints minWidth="140.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <!-- Fila 0: Cliente Obligatorio y Tipo de Plan -->
        <Label text="Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="cmbCliente" prefWidth="250.0" promptText="Seleccione Cliente" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Tipo de Plan:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <ComboBox fx:id="cmbTipoPlan" prefWidth="200.0" promptText="Seleccione tipo" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <!-- Fila 1: Código y Nombre -->
        <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtCodigo" promptText="Ej: PLN-01" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtNombre" promptText="Nombre del plan" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <!-- Fila 2: Duración, Valor Mensual y Descripción -->
        <Label text="Duración (Meses):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtDuracionMeses" promptText="Ej: 1, 3, 12" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Valor Mensual:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <TextField fx:id="txtValorMensual" promptText="Costo mensual ($)" GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtDescripcion" promptText="Descripción detallada" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="3" />

        <!-- Campos Exclusivos para Plan Personalizado (Builder) -->
        <Separator GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="4" />

        <Label fx:id="lblSesiones" text="Cantidad Sesiones:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="txtCantidadSesiones" promptText="N° de sesiones" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <Label fx:id="lblEspecialidad" text="Especialidad:" GridPane.columnIndex="2" GridPane.rowIndex="5" />
        <TextField fx:id="txtEspecialidad" promptText="Ej: Musculación, Crossfit" GridPane.columnIndex="3" GridPane.rowIndex="5" />

        <Label fx:id="lblObjetivos" text="Objetivos Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <TextField fx:id="txtObjetivos" promptText="Objetivos del cliente" GridPane.columnIndex="1" GridPane.rowIndex="6" />

        <Label fx:id="lblEntrenador" text="Entrenador Asignado:" GridPane.columnIndex="2" GridPane.rowIndex="6" />
        <ComboBox fx:id="cmbEntrenador" prefWidth="200.0" promptText="Seleccionar entrenador" GridPane.columnIndex="3" GridPane.rowIndex="6" />
    </GridPane>

    <!-- Botones CRUD + Patrón Prototype (Clonar) -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#handleCrearPlan" style="-fx-background-color: #2ec4b6; -fx-text-fill: white; -fx-font-weight: bold;" text="Crear Plan (Factory/Builder)" />
        <Button onAction="#handleActualizarPlan" text="Actualizar" />
        <Button onAction="#handleEliminarPlan" style="-fx-background-color: #e63946; -fx-text-fill: white;" text="Eliminar" />
        <Button onAction="#handleLimpiarCampos" text="Limpiar" />
        <Separator orientation="VERTICAL" />
        <Button onAction="#handleClonarPlan" style="-fx-background-color: #ff9f1c; -fx-text-fill: white; -fx-font-weight: bold;" text="Clonar Plan (Prototype)" />
    </HBox>

    <!-- Tabla de Planes -->
    <TableView fx:id="tblPlanes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Código" />
            <TableColumn fx:id="colCliente" prefWidth="130.0" text="Cliente" />
            <TableColumn fx:id="colNombre" prefWidth="140.0" text="Nombre" />
            <TableColumn fx:id="colTipo" prefWidth="110.0" text="Tipo Plan" />
            <TableColumn fx:id="colDuracion" prefWidth="60.0" text="Meses" />
            <TableColumn fx:id="colValorMensual" prefWidth="100.0" text="Valor Mensual" />
            <TableColumn fx:id="colEstado" prefWidth="80.0" text="Estado" />
            <TableColumn fx:id="colDescripcion" prefWidth="160.0" text="Descripción" />
        </columns>
    </TableView>
</VBox>